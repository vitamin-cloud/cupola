# Copy into Dockge's .env editor for the "alice-voice" stack.
# These values stay on the server. Never paste them into chat or commit them.

# Folder on your NAS pool where ALL of Alice's media and outputs live.
# (Create it first. Later we'll move it to its own dataset.)
ALICE_DATA=/mnt/YOUR_POOL/alice-voice

# The address you use for Immich in your browser, e.g. http://192.168.1.50:30041
IMMICH_URL=http://YOUR_SERVER_IP:30041
# Immich -> Account Settings -> API Keys. Read-only scopes are enough:
# album.read, asset.read, asset.download (or "all" on older Immich versions).
IMMICH_API_KEY=
# Exact album name (or the album's ID from its URL).
IMMICH_ALBUM=Alice voice

# Hugging Face read token (needed from step 3, diarization). Optional for now.
HF_TOKEN=
